{
  "name": "@baiiii/dsh-wallpaper-local",
  "version": "1.0.18",
  "description": "DSH wallpaper plugin: local Wallpaper Engine/Steam picker, video background, scene.pkg texture extraction",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiiii279/dsh-wallpaper-local.git"
  },
  "homepage": "https://github.com/baiiii279/dsh-wallpaper-local",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wallpaper",
    "plugin",
    "wallpaper-engine",
    "cordis"
  ],
  "bugs": {
    "url": "https://github.com/baiiii279/dsh-wallpaper-local/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
